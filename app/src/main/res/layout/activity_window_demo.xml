<?xml version="1.0" encoding="utf-8"?>
<!-- Activity 布局：全屏 edge-to-edge，内容延伸到状态栏和导航栏下方 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:ignore="Overdraw,MergeRootFrame">

    <!-- 按钮列：靠右侧垂直居中；底部 inset 由代码设置，避免被导航栏挡住 -->
    <LinearLayout
        android:id="@+id/btn_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:orientation="vertical"
        android:paddingEnd="24dp"
        android:paddingStart="0dp"
        tools:ignore="UselessParent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_show_popup"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:text="@string/show_popup" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_show_fullscreen"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/show_fullscreen_popup" />

        <!-- 点一下：Activity 背景立刻清成透明（露出壁纸），随后每 2s 在两张壁纸间切换 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_transparent_wallpaper"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/transparent_bg_wallpaper" />
    </LinearLayout>
</FrameLayout>
